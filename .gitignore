# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/
*.egg
SDIST/
.eggs/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE / Editor
.idea/
# Contents rather than the directory: git will not re-include a file whose
# parent directory is excluded, so `.vscode/` here would make the two
# negations below silently do nothing. The governance seed checks those two
# files in; everything else under .vscode/ stays local.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# Testing / Coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Type checking
.mypy_cache/
.pytype/
.pyre/

# Documentation builds
docs/_build/
site/

# Database
*.db
*.sqlite
*.sqlite3

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
*.temp

docs/screenshots/*
# The ring's recordings are written by the ordinary test run and committed, so
# a change to the ring shows up in `git status` rather than silently diverging
# from the README that embeds them. The other screenshots here are force-added
# by hand, which means a regenerated one is invisible until somebody remembers.
!docs/screenshots/rad_ring_*.svg
!docs/screenshots/dashboard_help.svg
!docs/screenshots/dashboard_settings.svg
!docs/screenshots/tab_dossier_wide.svg
!docs/screenshots/tab_deltas_desktop.svg
!docs/screenshots/content_viewer_readme.svg
# The Overview tab, which is where the dashboard opens. Carried by the
# quickstart, the index and the dashboard guide -- the last of which had an
# ASCII diagram of a tab layout that no longer existed until this replaced it.
!docs/screenshots/tab_overview_desktop.svg

# Jupyter Notebook
.ipynb_checkpoints/

# UV / pip
.uv/
pip-wheel-metadata/
# Generated by scripts/license_gate.py; CI uploads it as an artifact.
license-report.json
test-output.txt

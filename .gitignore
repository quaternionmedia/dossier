# IDE / Editor
.idea/
# Contents rather than the directory: git will not re-include a file whose
# parent directory is excluded, so `.vscode/` here would make the two
# negations below silently do nothing. The governance seed checks those two
# files in; everything else under .vscode/ stays local.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

